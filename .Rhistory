scores_LOOCV<- append(scores_LOOCV, score)
}
scores<- data.frame( Seed= rep(c(1, 2, 3, 4, 5),3),
Approach= c(rep("Validation",5),rep("K-Fold",5),rep("LOOCV",5)),
RMSE= c(scores_vsa, scores_kfold, scores_LOOCV)
)
ggplot(scores, ) +
geom_line(aes(x=Seed,y=RMSE,col=Approach), size=0.5)+
theme_bw()
