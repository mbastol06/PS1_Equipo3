## Loop over the different values of the seed:
for (i in 1:length(seeds))  {
set.seed(seeds[i]) ## set the seed
inTrain <- createDataPartition(
y = db$totalHoursWorked,
p = .80,
list = FALSE
)
## define test a training datasets
training <- db[ inTrain,]
testing  <- db[-inTrain,]
## train the model
model <- lm(form_3,
data = training)
predictions <- predict(model, testing)
score<- RMSE(predictions, testing$totalHoursWorked )
# save the RMSE
scores_vsa<- append(scores_vsa, score)
}
scores_kfold <- c()
## Loop over the different values of the seed:
for (i in 1:length(seeds))  {
## set seed
set.seed(seeds[i])
## define cross validation method
