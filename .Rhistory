geom_point(size = 3,fill = "steelblue", color = "black", alpha = 0.6) +
geom_errorbar(aes(ymin = cf_0.05, ymax = cf_0.95), width = 0.2,fill = "steelblue", color = "black", alpha = 0.6) +
theme_minimal() +
labs(x = "Model", y = "Peak Age",
title = "Peak Age with 95% CI across Models")
